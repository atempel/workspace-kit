# Claude Code container config (login/credentials) — local-only, never commit
.claude_global/

# Node (core/generator.js's dev tooling — jsdom for core/parity-check.js)
node_modules/

# Claude Design prototype exports — only the .dc.html markup under docs/design/
# is versioned as the visual reference (see DECISIONS.md, 2026-07-28); the full
# project export (shadcn bundle, ~850KB self-contained page, thumbnails) is not.
docs/design/*.zip
docs/design/_ds/
docs/design/workspace-kit-prototipo.html

# Python bytecode (core/ and .github/scripts/ are run directly, never packaged)
__pycache__/
*.py[cod]

# Local GitHub credentials — never commit (public repo). The real file
# lives in .git/, which git never versions; these rules guard against a copy
# landing anywhere inside the working tree by accident.
.github/git-credentials
*.git-credentials

# Dashboard build output (web/) — regenerate with `npm --prefix web run build`
web/dist/

# Playwright output from web/check-ui.mjs — evidence for a run, not source.
web/screenshots/

# Claude Code's own worktrees and per-machine settings. The git layer's
# convention is .worktrees/ (see core/git.js), but Claude Code's EnterWorktree
# puts its own under .claude/worktrees/ — a checkout of a branch that already
# lives in this repo, so versioning it would nest the repo inside itself.
# settings.local.json is per-machine permissions, not project config.
.claude/worktrees/
.claude/settings.local.json

# Editor-local state. The repo pins no editor.
.zed/
.vscode/
.idea/
